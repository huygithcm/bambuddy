# Sao chép thành .env và chỉnh theo nhu cầu.

# Cổng host expose service (mặc định 3333)
YOLO_PORT=3333

# Đường dẫn trọng số model bên trong container (mount qua volume ./models)
YOLO_MODEL_PATH=/models/best.pt

# Ngưỡng confidence tối thiểu giữ lại một box [0..1]
YOLO_CONFIDENCE_THRESHOLD=0.25

# Ngưỡng IoU cho NMS [0..1]
YOLO_IOU_THRESHOLD=0.45

# Kích thước cạnh ảnh đưa vào model (px)
YOLO_IMAGE_SIZE=640

# Thiết bị suy luận: cpu | cuda | cuda:0
YOLO_DEVICE=cpu

# Nhãn gán cho mỗi detection (Bambuddy chỉ dùng confidence, nhãn chỉ để log)
YOLO_DETECTION_LABEL=failure
