# Force CRLF line endings for Windows batch files so cmd.exe can parse them
# regardless of the user's core.autocrlf setting.
*.bat text eol=crlf

# Shell scripts must keep LF endings so they run inside Linux containers.
# Without this, a Windows checkout (autocrlf) rewrites them to CRLF and the
# container fails with "exec .../docker-entrypoint.sh: no such file or directory".
*.sh text eol=lf
